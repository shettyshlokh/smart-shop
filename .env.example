# Copy this file to ".env" and fill in your keys.
# Anything left empty is simply switched off (messages are printed in the terminal instead).

SECRET_KEY=put-a-long-random-string-here

# ---------- Test payments ----------
# While Razorpay keys are empty, customers see "Online (test mode)" for demos.
# Set this to 0 before using the app with real customers.
DEMO_PAYMENTS=1

# ---------- Razorpay (online payment) ----------
# Free test keys: https://dashboard.razorpay.com -> Settings -> API Keys (use Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Twilio (SMS + WhatsApp) ----------
# https://console.twilio.com  (free trial: only sends to numbers you verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=           # your Twilio number, e.g. +15551234567
TWILIO_WHATSAPP_FROM=      # sandbox number, e.g. +14155238886
DEFAULT_COUNTRY_CODE=+91

# ---------- Email (Gmail example) ----------
# Gmail: turn on 2-Step Verification, then create an "App password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- When hosted online (https) ----------
HTTPS=1

# ---------- Android app (fill these after making the APK in PWABuilder) ----------
ANDROID_PACKAGE=
ANDROID_SHA256=

# ---------- Shown on the Privacy Policy page ----------
DEVELOPER_NAME=Your Name
CONTACT_EMAIL=you@example.com
